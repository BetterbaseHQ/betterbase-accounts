  "query": "\n            INSERT INTO accounts (issuer, username, email)\n            VALUES ($1, $2, $3)\n            ON CONFLICT (issuer, username) DO UPDATE SET issuer = EXCLUDED.issuer\n            RETURNING id, issuer, username, email,\n                      opaque_record, wrapped_root_key,\n                      created_at, updated_at\n            ",
